# Copy to .env (never commit it). Used by docker-compose.yml.
# Generate secrets with:  openssl rand -base64 36
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
SESSION_SECRET=

PUBLIC_URL=https://psa.example.com
SITE_ADDRESS=psa.example.com

# Entra ID app registration: see docs/ENTRA_SETUP.md
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional: change if ports 80/443 are taken (e.g. you run your own reverse proxy)
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Email-to-ticket (optional until you set it up): see docs/MAIL_SETUP.md
# Use a SEPARATE app registration from the sign-in one above.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_MAILBOX=support@yourmsp.com
# MAIL_POLL_SECONDS=60
# GCC High / other sovereign clouds only:
# GRAPH_BASE_URL=https://graph.microsoft.us/v1.0
# GRAPH_LOGIN_URL=https://login.microsoftonline.us

# Vendor integrations (NinjaOne, Hudu): see docs/INTEGRATIONS.md
# Encrypts the vendor API credentials saved in the database. Keep it in your secret store, NOT with
# database backups. Generate once with:
#   docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
