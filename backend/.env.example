# Local development (no Docker for the API). Copy to backend/.env
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://psa_app:app_dev@localhost:5432/psa
MIGRATION_DATABASE_URL=postgresql+psycopg://psa_owner:owner_dev@localhost:5432/psa
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=dev-only-change-me
DEV_LOGIN_ENABLED=true
# ENTRA_TENANT_ID= / ENTRA_CLIENT_ID= / ENTRA_CLIENT_SECRET=  (optional in dev)
